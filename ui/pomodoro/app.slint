import { PomoPhase, PomoView } from "types.slint";
import { DebugScreen, FocusScreen, IdleScreen } from "screens.slint";

// The Pomodoro app: picks the screen for the current phase.
export component PomodoroApp {
    in property <PomoView> pomo;
    in property <[string]> preset-labels;

    if root.pomo.phase == PomoPhase.ready: IdleScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
        preset-labels: root.preset-labels;
    }
    if root.pomo.phase == PomoPhase.focus: FocusScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
    }
    // Not designed yet.
    if root.pomo.phase != PomoPhase.ready && root.pomo.phase != PomoPhase.focus: DebugScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
    }
}
