import { PomoPhase, PomoView } from "types.slint";
import { AlarmScreen, BreakScreen, FocusScreen, IdleScreen } from "screens.slint";

// The Pomodoro app: picks the screen for the current phase.
export component PomodoroApp {
    in property <PomoView> pomo;
    in property <[string]> preset-labels;

    if root.pomo.phase == PomoPhase.ready: IdleScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
        preset-labels: root.preset-labels;
    }
    if root.pomo.phase == PomoPhase.focus: FocusScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
    }
    if root.pomo.phase == PomoPhase.focus-done || root.pomo.phase == PomoPhase.break-done: AlarmScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
    }
    if root.pomo.phase == PomoPhase.on-break: BreakScreen {
        width: 100%;
        height: 100%;
        pomo: root.pomo;
    }
}
