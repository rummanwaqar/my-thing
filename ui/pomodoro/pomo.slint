import { Theme } from "theme.slint";
import { Motion } from "motion.slint";
import { ProgressRing } from "parts.slint";

export enum PomoMood { sleepy, focused, relaxed, excited }

// Squashes its children slightly in a loop, anchored near their bottom, like breathing.
component Breathing inherits Rectangle {
    in property <duration> period;
    in property <float> stretch;       // extra width at the peak (0.03 = 3 %)
    in property <float> squash;        // lost height at the peak
    in property <float> anchor-y: 0.9; // fraction of the height that stays put

    property <float> breath: Motion.wave(Motion.cycle(root.period, 0s));

    transform-origin: { x: self.width / 2, y: self.height * root.anchor-y };
    transform-scale-x: 1 + root.stretch * self.breath;
    transform-scale-y: 1 - root.squash * self.breath;

    @children
}

// Idle: asleep inside the dashed ring, z's floating up.
component SleepyPomo {
    // The design's dashed ring, as a static image tinted from the theme.
    Image {
        width: 100%;
        height: 100%;
        source: @image-url("images/ring-dashed.svg");
        colorize: Theme.track;
    }

    // Three z's growing as they float up and fade, 3 s each, 1 s apart.
    for letter[i] in ["z", "z", "Z"]: Text {
        property <float> p: Motion.cycle(3s, i * 1s);
        property <float> rise: Motion.ease-out(self.p);
        text: letter;
        font-size: 26px * (0.7 + 0.45 * self.rise);
        font-weight: 800;
        color: Theme.text-dim;
        x: 228px + 26px * self.rise;
        y: 44px - 60px * self.rise;
        opacity: self.p < 0.25 ? self.p / 0.25 : 1 - (self.p - 0.25) / 0.75;
    }

    Breathing {
        x: 50px;
        y: 50px;
        width: 240px;
        height: 240px;
        period: 4s;
        stretch: 0.025;
        squash: 0.015;

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-sleepy.svg");
        }
    }
}

// Focus: peeking over a laptop, lit by its screen, sparks flying from the keys.
component FocusedPomo {
    in property <float> ring-value;
    in property <bool> paused;

    ProgressRing {
        width: 100%;
        height: 100%;
        value: root.ring-value;
    }

    // The design's 200×200 drawing at 1.1×, from (60, 20).
    Breathing {
        x: 60px;
        y: 20px;
        width: 220px;
        height: 220px;
        period: 3s;
        stretch: 0.03;
        squash: 0.02;
        anchor-y: 0.84; // bottom of the tomato, not of the drawing

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-focused-body.svg");
        }

        // Screen light on the face, pulsing every 2.2 s.
        Image {
            visible: !root.paused;
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-focused-glow.svg");
            opacity: 0.14 + 0.12 * Motion.wave(Motion.cycle(2.2s, 0s));
        }

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-focused-face.svg");
        }

        // Blinks once every 4.5 s: open for 90 %, shut at 94 %, open again by 100 %.
        Image {
            property <float> p: Motion.cycle(4.5s, 0s);
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-focused-eyes.svg");
            transform-origin: { x: self.width / 2, y: self.height * 0.6 }; // eye level
            transform-scale-y: self.p < 0.9 ? 1
                : self.p < 0.94 ? 1 - 0.9 * (self.p - 0.9) / 0.04
                : 0.1 + 0.9 * (self.p - 0.94) / 0.06;
        }
    }

    // Typing sparks either side of the laptop, flashing alternately every 0.5 s.
    for commands[i] in ["M78 176 L68 168 M74 186 L62 186", "M262 176 L272 168 M266 186 L278 186"]: Path {
        property <float> p: Motion.cycle(0.5s, i * 0.25s);
        visible: !root.paused;
        width: 100%;
        height: 100%;
        viewbox-width: 340;
        viewbox-height: 340;
        commands: commands;
        stroke: Theme.spark;
        stroke-width: 4px;
        stroke-line-cap: round;
        opacity: self.p < 0.4 ? self.p / 0.4 : self.p < 0.6 ? 1 : (1 - self.p) / 0.4;
    }

    Image {
        width: 100%;
        height: 100%;
        source: @image-url("images/laptop.svg");
    }
}

// Break: swaying in sunglasses, coffee steaming beside the ring.
component RelaxedPomo {
    in property <float> ring-value;

    ProgressRing {
        width: 100%;
        height: 100%;
        value: root.ring-value;
        track: Theme.break-track;
        fill: Theme.break-ring;
    }

    // Sways ±4° every 2.8 s (GPU renderer only).
    Image {
        x: 50px;
        y: 50px;
        width: 240px;
        height: 240px;
        source: @image-url("images/pomo-relaxed.svg");
        transform-origin: { x: self.width / 2, y: self.height * 0.92 };
        transform-rotation: -4deg + 8deg * Motion.wave(Motion.cycle(2.8s, 0s));
    }

    // The mug, with three wisps of steam rising and fading, 2.4 s each, 0.8 s apart.
    Rectangle {
        x: 262px;
        y: 236px;
        width: 64px;
        height: 80px;

        for commands[i] in ["M20 30 Q14 22 20 14", "M30 30 Q24 20 30 10", "M40 30 Q34 22 40 14"]: Path {
            property <float> p: Motion.cycle(2.4s, i * 0.8s);
            y: 6px - 28px * Motion.ease-out(self.p);
            width: 100%;
            height: 100%;
            viewbox-width: 64;
            viewbox-height: 80;
            commands: commands;
            stroke: Theme.ink;
            stroke-width: 3px;
            stroke-line-cap: round;
            // Peaks at 0.9 × the design's 0.6 opacity, 40 % of the way up.
            opacity: 0.54 * (self.p < 0.4 ? self.p / 0.4 : (1 - self.p) / 0.6);
        }

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("images/mug.svg");
        }
    }
}

// Time's up: jumping for joy, squashing on landing, arms waving.
component ExcitedPomo {
    property <float> p: Motion.cycle(0.6s, 0s);
    // Height of the bounce: 0 on the ground (first and last 15 %), 1 at the top.
    property <float> air: self.p < 0.15 || self.p > 0.85 ? 0 : sin((self.p - 0.15) / 0.7 * 180deg);
    // 1 at the moment of landing, fading out over the first/last 15 %.
    property <float> landing: self.p < 0.15 ? 1 - self.p / 0.15 : self.p > 0.85 ? (self.p - 0.85) / 0.15 : 0;
    // Arm angle: out to 30° and back every 0.3 s.
    property <angle> wave: 30deg * Motion.wave(Motion.cycle(0.3s, 0s));

    // Rotate point (x, y) around (cx, cy). The arms animate their Path points
    // directly, because the software renderer ignores transform-rotation.
    pure function rotated-x(x: float, y: float, cx: float, cy: float, a: angle) -> float {
        return cx + (x - cx) * cos(a) - (y - cy) * sin(a);
    }
    pure function rotated-y(x: float, y: float, cx: float, cy: float, a: angle) -> float {
        return cy + (x - cx) * sin(a) + (y - cy) * cos(a);
    }

    // Shadow shrinks and fades while Pomo is in the air.
    Rectangle {
        width: 140px * (1 - 0.4 * root.air);
        height: 18px * (1 - 0.4 * root.air);
        x: 170px - self.width / 2;
        y: 327px - self.height / 2;
        border-radius: self.height / 2;
        background: Theme.ink;
        opacity: 0.3 - 0.15 * root.air;
    }

    // The design's 200×200 drawing at 1.4×, from (30, 40), lifted by the bounce.
    Rectangle {
        x: 30px;
        y: 40px - 44px * root.air;
        width: 280px;
        height: 280px;
        transform-origin: { x: self.width / 2, y: self.height };
        transform-scale-x: 1 + 0.08 * root.landing - 0.05 * root.air;
        transform-scale-y: 1 - 0.08 * root.landing + 0.06 * root.air;

        // Arms behind the body. side -1 = left, 1 = right: the right arm mirrors
        // the left around x = 100, turning the other way.
        for side in [-1, 1]: Path {
            property <angle> a: root.wave * side;
            property <float> shoulder-x: 100 + 70 * side;
            width: 100%;
            height: 100%;
            viewbox-width: 200;
            viewbox-height: 200;
            stroke: Theme.tomato-dark;
            stroke-width: 14px; // 10 in the 200-unit drawing, shown at 280 px
            stroke-line-cap: round;

            MoveTo { x: parent.shoulder-x; y: 120; }
            QuadraticTo {
                control-x: root.rotated-x(100 + 88 * side, 104, parent.shoulder-x, 120, parent.a);
                control-y: root.rotated-y(100 + 88 * side, 104, parent.shoulder-x, 120, parent.a);
                x: root.rotated-x(100 + 90 * side, 80, parent.shoulder-x, 120, parent.a);
                y: root.rotated-y(100 + 90 * side, 80, parent.shoulder-x, 120, parent.a);
            }
        }

        Image {
            width: 100%;
            height: 100%;
            source: @image-url("images/pomo-excited.svg");
        }
    }
}

// Pomo the tomato in its 340×340 character area, with the ring behind it.
// Picks one of the mood components above (Slint needs them defined first).
export component Pomo {
    in property <PomoMood> mood;
    in property <float> ring-value: 1.0; // filled fraction of the progress ring (focused, relaxed)
    in property <bool> paused;           // focused: screen glow off, no typing sparks

    width: Theme.character-size;
    height: Theme.character-size;

    if root.mood == PomoMood.sleepy: SleepyPomo {
        width: 100%;
        height: 100%;
    }
    if root.mood == PomoMood.focused: FocusedPomo {
        width: 100%;
        height: 100%;
        ring-value: root.ring-value;
        paused: root.paused;
    }
    if root.mood == PomoMood.relaxed: RelaxedPomo {
        width: 100%;
        height: 100%;
        ring-value: root.ring-value;
    }
    if root.mood == PomoMood.excited: ExcitedPomo {
        width: 100%;
        height: 100%;
    }
}
