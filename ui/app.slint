import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";
import "fonts/Inter-ExtraBold.ttf";
import "fonts/Inter-Black.ttf";
import "fonts/Fredoka-SemiBold.ttf"; // countdown digits

import { PomoPhase, PomoView } from "pomodoro/types.slint";
import { PomodoroApp } from "pomodoro/app.slint";
import { CalendarApp } from "calendar/app.slint";
import { CalRow, CalRowKind } from "calendar/types.slint";

// Re-exported so Rust can construct them (main.rs `push`).
export { PomoPhase, PomoView, CalRow, CalRowKind }

// Mirrors pages::Page.
export enum AppPage { calendar, pomodoro }

// Owns the input and hosts the current app. Preset buttons switch apps (main.rs);
// app state lives in Rust, so a hidden app keeps running.
export component MainWindow inherits Window {
    default-font-family: "Inter";
    width: 800px;
    height: 480px;

    in property <AppPage> page;
    in property <PomoView> pomo;
    in property <[string]> preset-labels;   // "25 / 5", ... from pomodoro::PRESETS
    in property <string> today-label;       // calendar placeholder
    in property <string> google-status;     // login state, or "12 events · synced 12:03 · me@x"
    in property <bool> calendar-ready;      // logged in and synced at least once
    in property <[CalRow]> calendar-rows;   // agenda, from the top visible row

    // Handled in Rust (main.rs). knob-turned is also invoked by the evdev knob thread on device.
    callback knob-turned(int); // +1 = clockwise; -1 = anticlockwise
    callback knob-pressed();
    callback preset(int);      // 1–4
    callback back();

    forward-focus: fs;

    fs := FocusScope {
        // Desktop key map; on device, gpio-keys send Enter / Esc / 1–4 the same way.
        key-pressed(event) => {
            if (event.text == Key.LeftArrow)  { root.knob-turned(-1); return accept; }
            if (event.text == Key.RightArrow) { root.knob-turned(1);  return accept; }
            if (event.text == Key.Return)     { root.knob-pressed();  return accept; }
            if (event.text == Key.Escape)     { root.back();          return accept; }
            if (event.text == "1") { root.preset(1); return accept; }
            if (event.text == "2") { root.preset(2); return accept; }
            if (event.text == "3") { root.preset(3); return accept; }
            if (event.text == "4") { root.preset(4); return accept; }
            return reject;
        }

        if root.page == AppPage.calendar: CalendarApp {
            width: 100%;
            height: 100%;
            today-label: root.today-label;
            status: root.google-status;
            ready: root.calendar-ready;
            rows: root.calendar-rows;
        }
        if root.page == AppPage.pomodoro: PomodoroApp {
            width: 100%;
            height: 100%;
            pomo: root.pomo;
            preset-labels: root.preset-labels;
        }
    }
}
