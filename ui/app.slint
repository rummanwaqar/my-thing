import "fonts/Fredoka-Regular.ttf";
import "fonts/Fredoka-SemiBold.ttf";

import { Button, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    default-font-family: "Fredoka";

    width: 800px;
    height: 480px;

    in-out property <int> counter: 0;
    callback clicked();

    VerticalBox {
        Text { text: "Hello, My Thinbg"; font-size: 32px; font-weight: 600; }
        Text { text : "Clicked " + root.counter + " times"; font-size: 32px; }
        Button { text: "Click Me"; clicked => { root.clicked(); } }
    }
}
