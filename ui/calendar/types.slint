// Mirrors calendar::EventView (built in main.rs `cal_event`).
export struct CalEvent {
    title: string,
    detail: string,      // "10:45 · Studio 4A"
    location: string,
    range: string,       // "10:15 – 10:32"
    big: string,         // "23", "1:08"
    big-unit: string,    // "MIN", "HR", "DAYS"
    badge: string,       // kind letter: F focus, T booked by me, W not accepted, P other
    color: color,        // the kind's color
    ink: color,          // readable text color on `color`
}

// Mirrors calendar::BoardView.
export struct CalBoard {
    has-now: bool,
    now: CalEvent,
    now-left: string,    // "10"
    now-left-unit: string, // "MIN LEFT"
    now-progress: float, // 0.0 → 1.0 of the event in progress
    departures: [CalEvent], // departures list rows after the NOW row (3, or 4 without one)
    all-day-count: int,
    legend: [CalEvent],  // one badge per kind of event present, for the header
}
