import { CalBoard, CalEvent } from "types.slint";

// Colors from the "A · Departures list" board of the design canvas: a light
// board under a black header.
global CalTheme {
    out property <color> text: #ffffff;         // on the black header and chips
    out property <color> ink: #111111;          // main text
    out property <color> accent: #fccc0a;       // NOW row, sync problems
    out property <color> accent-muted: #3d3300; // secondary text on the NOW row
    out property <color> paper: #ffffff;
    out property <color> header: #000000;
    out property <color> header-pill: #262626;
    out property <color> label: #444444;        // countdown units
    out property <color> muted: #555555;        // detail lines
    out property <color> divider: #e5e5e5;

    // Side insets: the Car Thing's knob covers part of the screen's edge.
    out property <length> pad-x: 48px;
}

// Event-kind letter in a colored circle (F focus, T booked by me, W not accepted, P other).
component Badge {
    in property <CalEvent> event;
    in property <length> size: 28px;
    in property <length> outline: 0px;

    width: root.size;
    height: root.size;
    Rectangle {
        border-radius: root.size / 2;
        background: root.event.color;
        border-width: root.outline;
        border-color: CalTheme.ink;
    }
    Text {
        text: root.event.badge;
        color: root.event.ink;
        font-size: root.size / 2;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Big number over a small unit, right-aligned: "23" / "MIN".
component Countdown {
    in property <string> value;
    in property <string> unit;
    in property <color> unit-color: CalTheme.label;

    VerticalLayout {
        alignment: center;
        Text {
            text: root.value;
            color: CalTheme.ink;
            font-size: 48px;
            font-weight: 800;
            horizontal-alignment: right;
        }
        Text {
            text: root.unit;
            color: root.unit-color;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            horizontal-alignment: right;
        }
    }
}

// The event in progress: accent row, NOW chip, time left, progress bar.
component NowRow {
    in property <CalBoard> board;

    height: 101px; // (480 − 72 header − 3 rule) / 4 rows
    Rectangle {
        background: CalTheme.accent;
    }
    HorizontalLayout {
        padding-left: CalTheme.pad-x;
        padding-right: CalTheme.pad-x;
        spacing: 16px;
        Badge {
            event: root.board.now;
            size: 44px;
            outline: 2px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    width: chip.preferred-width + 12px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: CalTheme.ink;
                    chip := Text {
                        text: "NOW";
                        color: CalTheme.text;
                        font-size: 11px;
                        font-weight: 800;
                        letter-spacing: 1px;
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.board.now.title;
                    color: CalTheme.ink;
                    font-size: 24px;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            Text {
                text: root.board.now.location == "" ? root.board.now.range : root.board.now.range + " · " + root.board.now.location;
                color: CalTheme.accent-muted;
                font-size: 15px;
                overflow: elide;
            }
        }
        Countdown {
            value: root.board.now-left;
            unit: root.board.now-left-unit;
            unit-color: CalTheme.ink;
        }
    }
    // How much of it is over.
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        height: 5px;
        width: parent.width * root.board.now-progress;
        background: CalTheme.ink;
    }
}

// An upcoming event: badge, title, detail, countdown.
component DepartureRow {
    in property <CalEvent> event;
    in property <bool> last;

    height: 101px; // (480 − 72 header − 3 rule) / 4 rows
    HorizontalLayout {
        padding-left: CalTheme.pad-x;
        padding-right: CalTheme.pad-x;
        spacing: 16px;
        Badge {
            event: root.event;
            size: 44px;
            y: (parent.height - self.height) / 2;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: root.event.title;
                color: CalTheme.ink;
                font-size: 24px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.event.detail;
                color: CalTheme.muted;
                font-size: 15px;
                overflow: elide;
            }
        }
        Countdown {
            value: root.event.big;
            unit: root.event.big-unit;
        }
    }
    if !root.last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: CalTheme.divider;
    }
}

// The Calendar app (design "A · Departures list"): black header, then the event
// in progress and the next departures as rows, like a station display.
export component CalendarApp {
    in property <string> today-label;   // "Wednesday, Nov 11"
    in property <string> clock-label;   // "10:22"
    in property <string> status;        // login state, or a sync problem
    in property <bool> ready;           // logged in and synced at least once
    in property <CalBoard> board;

    Rectangle {
        background: CalTheme.paper;
    }

    VerticalLayout {
        // Header: date, sync problem if any, kind legend, all-day count, clock.
        Rectangle {
            height: 72px;
            background: CalTheme.header;
            HorizontalLayout {
                padding-left: CalTheme.pad-x;
                padding-right: CalTheme.pad-x;
                spacing: 16px;
                Text {
                    text: root.today-label;
                    color: CalTheme.text;
                    font-size: 28px;
                    font-weight: 800;
                    letter-spacing: -0.5px;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.ready ? root.status : "";
                    color: CalTheme.accent;
                    font-size: 13px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.ready: HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    for kind in root.board.legend: Badge {
                        event: kind;
                        size: 24px;
                        y: (parent.height - self.height) / 2;
                    }
                }
                if root.ready && root.board.all-day-count > 0: Rectangle {
                    width: pill.preferred-width + 24px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 14px;
                    background: CalTheme.header-pill;
                    pill := Text {
                        text: root.board.all-day-count + " ALL-DAY";
                        color: CalTheme.text;
                        font-size: 13px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                    }
                }
                Text {
                    text: root.clock-label;
                    color: CalTheme.text;
                    font-size: 32px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            // White rule under the header (the black one follows below it).
            Rectangle {
                y: parent.height - 3px;
                height: 3px;
                background: CalTheme.text;
            }
        }

        // Black rule under the header's white one.
        Rectangle {
            height: 3px;
            background: CalTheme.header;
        }

        if root.ready && root.board.has-now: NowRow {
            board: root.board;
        }
        if root.ready: VerticalLayout {
            for event[i] in root.board.departures: DepartureRow {
                event: event;
                last: i == root.board.departures.length - 1;
            }
        }
        if root.ready && !root.board.has-now && root.board.departures.length == 0: Text {
            vertical-stretch: 1;
            text: "Nothing else scheduled";
            color: CalTheme.muted;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Before the first sync: the login state, centered.
        if !root.ready: Text {
            vertical-stretch: 1;
            text: root.status;
            color: CalTheme.muted;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        Rectangle {
            vertical-stretch: 1;
        }
    }
}

// One line of the reminder's hint bar: a stroke icon and what the input does.
component Hint {
    in property <string> icon;   // SVG path commands on a 24×24 grid
    in property <string> label;

    HorizontalLayout {
        spacing: 8px;
        Path {
            width: 22px;
            height: 22px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            commands: root.icon;
            stroke: CalTheme.ink;
            stroke-width: 2px;
            fill: transparent;
        }
        Text {
            text: root.label;
            color: CalTheme.ink;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Design "D · Reminder takeover": full screen, 5 minutes before an event, over
// whatever page is showing. main.rs handles its inputs while it's up.
export component ReminderScreen {
    in property <CalEvent> event;       // detail "10:45 – 11:30 · Studio 4A", big "2" / "MIN"
    in property <string> clock-label;

    // Swallow pointer input so nothing underneath reacts.
    TouchArea { }
    Rectangle {
        background: CalTheme.accent;
    }

    VerticalLayout {
        padding-top: 26px;
        padding-bottom: 20px;
        padding-left: CalTheme.pad-x;
        padding-right: CalTheme.pad-x;
        alignment: space-between;

        HorizontalLayout {
            Rectangle {
                width: pill.preferred-width + 28px;
                height: 36px;
                border-radius: 18px;
                background: CalTheme.ink;
                pill := Text {
                    text: "UP NEXT";
                    color: CalTheme.text;
                    font-size: 16px;
                    font-weight: 800;
                    letter-spacing: 2px;
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Text {
                text: root.clock-label;
                color: CalTheme.ink;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 24px;
            Badge {
                event: root.event;
                size: 96px;
                outline: 4px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 10px;
                Text {
                    text: root.event.title;
                    color: CalTheme.ink;
                    font-size: 46px;
                    font-weight: 900;
                    letter-spacing: -1px;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 112px; // two lines
                }
                Text {
                    text: root.event.detail;
                    color: CalTheme.accent-muted;
                    font-size: 20px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
            // Big countdown, sized to the digits (Inter: baseline 0.969 em, cap height 0.727 em).
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Rectangle {
                    // The −6 px letter spacing also comes off the last glyph's box,
                    // which would clip its right edge: add it back.
                    width: big.preferred-width + 6px;
                    height: 109px; // 0.727 × 150
                    big := Text {
                        x: 0;
                        y: -36px; // −(0.969 − 0.727) × 150
                        width: parent.width;
                        text: root.event.big;
                        color: CalTheme.ink;
                        font-size: 150px;
                        font-weight: 900;
                        letter-spacing: -6px;
                    }
                }
                Text {
                    text: root.event.big-unit;
                    color: CalTheme.ink;
                    font-size: 22px;
                    font-weight: 800;
                    letter-spacing: 1px;
                    horizontal-alignment: right;
                }
            }
        }

        VerticalLayout {
            spacing: 14px;
            Rectangle {
                height: 2px;
                background: CalTheme.ink;
            }
            HorizontalLayout {
                spacing: 32px;
                alignment: start;
                Hint {
                    icon: "M9 14L4 9l5-5 M4 9h11a5 5 0 0 1 0 10h-3";
                    label: "Back: dismiss";
                }
            }
        }
    }
}
