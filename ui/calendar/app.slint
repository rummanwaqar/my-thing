import { Theme } from "../pomodoro/theme.slint";

// The Calendar app. Placeholder: date, current/next event, and login / sync
// status. The event list comes next; real styling later.
export component CalendarApp {
    in property <string> today-label;   // e.g. "Saturday, 14 November"
    in property <string> next;          // e.g. "Next: 14:00 Lunch"
    in property <string> status;        // login state or sync status

    Rectangle {
        background: Theme.bg;
    }

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: "Calendar";
            color: Theme.text-dim;
            font-size: Theme.sub-size;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: root.today-label;
            color: Theme.text;
            font-size: 48px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.next;
            color: Theme.text;
            font-size: Theme.sub-size;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.status;
            color: Theme.hint;
            font-size: Theme.hint-size;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}
